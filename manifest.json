{
  "name": "Chat Token Counter (v2.4)",
  "description": "Exact token count on chatgpt.com using tiktoken (local).",
  "version": "2.4.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["build/content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}

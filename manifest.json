{
  "name": "Chat Workbench",
  "description": "Jump between turns in ChatGPT and count tokens locally.",
  "version": "2.7.0",
  "manifest_version": 3,
  "action": {
    "default_title": "Chat Workbench",
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "build/content.js"
      ],
      "css": [
        "content.css",
        "anchors.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}

{
  "name": "Chat Token Counter (v2.6)",
  "description": "Exact token count on chatgpt.com using tiktoken (local).",
  "version": "2.6.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "build/content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": []
}
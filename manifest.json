{
  "name": "Chat Workbench",
  "description": "Navigate ChatGPT conversations, count tokens locally, and customize the page with Aurora.",
  "version": "2.8.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/jump-brackets-16.png",
    "32": "icons/jump-brackets-32.png",
    "48": "icons/jump-brackets-48.png",
    "128": "icons/jump-brackets-128.png"
  },
  "action": {
    "default_title": "Chat Workbench",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/jump-brackets-16.png",
      "24": "icons/jump-brackets-24.png",
      "32": "icons/jump-brackets-32.png",
      "48": "icons/jump-brackets-48.png"
    }
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "build/content.js"
      ],
      "css": [
        "content.css",
        "anchors.css",
        "aurora.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage"]
}
